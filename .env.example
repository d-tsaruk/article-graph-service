# Copy to .env and fill in. docker compose substitutes these into docker-compose.yml.
# sk-... (uploads return 503 while empty)
OPENAI_API_KEY=

# Comma-separated list of App Tokens that clients exchange for JWTs.
APP_TOKENS=local-dev-app-token
# At least 32 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
NEO4J_PASSWORD=local-dev-password

# Optional: an OpenAI-compatible backend that supports Structured Outputs.
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4.1-mini
# VISION_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Tuning (defaults shown).
# NEO4J_DATABASE=neo4j
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=86400
# LLM_CONCURRENCY=4
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=3
# MAX_UPLOAD_BYTES=20971520
# MAX_PDF_PAGES=100
# MAX_CHUNKS=50
# STALE_PROCESSING_SECONDS=1800
# CHUNK_SIZE_CHARS=12000
# CHUNK_OVERLAP_CHARS=800
# PDF_MAX_VISUAL_ITEMS=30
# PDF_MIN_IMAGE_SIDE_PX=100
# PDF_RENDER_DPI=150
# PDF_MAX_RENDER_SIDE_PX=2048
# PDF_SCANNED_PAGE_MAX_CHARS=50
# PDF_DRAWINGS_RENDER_THRESHOLD=30
# CHARACTER_CANDIDATE_LIMIT=10
# RELATION_TYPE_CANDIDATE_SCORE=0.75

# Host ports (change to run a second stack next to this one).
# API_PORT=8000
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
