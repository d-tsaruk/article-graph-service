# Copy to .env and fill in. docker compose reads this file automatically.
OPENAI_API_KEY=sk-...

# Comma-separated list of App Tokens that clients exchange for JWTs.
APP_TOKENS=local-dev-app-token
# At least 32 characters, e.g. `openssl rand -hex 32`.
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
NEO4J_PASSWORD=local-dev-password

# Optional: any OpenAI-compatible backend (Azure OpenAI, vLLM, Ollama, OpenRouter, ...).
# OPENAI_BASE_URL=
# LLM_MODEL=gpt-4o-mini
# VISION_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Host ports (change to run a second stack next to this one).
# API_PORT=8000
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
